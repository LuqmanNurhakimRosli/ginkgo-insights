# Ginkgo — Environment configuration
# Copy to .env (git-ignored). NEVER commit real keys, and never put a secret in a VITE_ variable:
# every VITE_ value is embedded in the public JavaScript bundle.

# ── Public (client) ───────────────────────────────────────────────────────────
# Default copilot engine: analyst (on-device, no key) | gemini | groq | ollama
VITE_AI_PROVIDER=analyst
# Optional Python ML backend (PyTorch change detection / RF land cover)
VITE_BACKEND_URL=http://localhost:8000

# ── Server-only (read by src/services/ai/llmProxy.ts) ────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
