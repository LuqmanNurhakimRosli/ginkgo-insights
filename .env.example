# Ginkgo — Environment Configuration
# Copy this file to .env or .env.local. NEVER commit real API keys to Git.

# Frontend AI Provider: "mock" (default on-device), "gemini", "groq", "ollama"
VITE_AI_PROVIDER=mock

# Gemini API Key (For local client testing if running without backend)
# In production, Gemini is proxied securely via the FastAPI backend
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Backend Service URL
VITE_BACKEND_URL=http://localhost:8000
VITE_AI_BACKEND_URL=http://localhost:8000/api/copilot/chat

# Groq / Ollama Configuration (Optional)
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
