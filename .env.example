# Ginkgo — environment configuration example
# Copy to .env.local. Never commit real keys.

# AI provider used by the frontend: "mock" (default, always works) or "gemini".
VITE_AI_PROVIDER=mock

# Backend endpoint that proxies Gemini. Frontend → FastAPI backend → Gemini API.
# The Gemini API key lives ONLY on the backend, never in frontend source.
VITE_AI_BACKEND_URL=/api/ai/chat

# Optional map tile style URL for MapLibre GL JS.
# Leave empty to use the built-in prototype map canvas.
VITE_MAP_STYLE_URL=

# Feature flags (prototype)
VITE_USE_PERSON_A_MODEL=false
VITE_USE_PERSON_B_MODEL=false
VITE_USE_DUMMY_DATA=true
